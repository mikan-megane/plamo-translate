<Window x:Class="PlamoTranslatePopup.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLaMo翻訳 設定"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F7F7F7">

    <StackPanel Margin="18,16,18,16">

        <TextBlock Text="ショートカットキー"
                   FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <TextBlock Text="選択テキスト翻訳" VerticalAlignment="Center" />
            <TextBox x:Name="HotkeyTranslateBox"
                     Grid.Column="1"
                     Height="28"
                     VerticalContentAlignment="Center"
                     TextAlignment="Center"
                     IsReadOnly="True"
                     GotFocus="HotkeyBox_GotFocus"
                     LostFocus="HotkeyBox_LostFocus"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

            <TextBlock Grid.Row="1" Text="画面OCR翻訳" VerticalAlignment="Center" />
            <TextBox x:Name="HotkeyOcrBox"
                     Grid.Row="1" Grid.Column="1"
                     Height="28"
                     VerticalContentAlignment="Center"
                     TextAlignment="Center"
                     IsReadOnly="True"
                     GotFocus="HotkeyBox_GotFocus"
                     LostFocus="HotkeyBox_LostFocus"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
        </Grid>
        <TextBlock Text="ボックスをクリックしてから、割り当てたいキーを押してください(Esc: キャンセル)"
                   FontSize="11" Foreground="#808080" Margin="0,4,0,0" />

        <TextBlock Text="ポップアップ表示"
                   FontWeight="SemiBold" FontSize="13" Margin="0,18,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <TextBlock Text="自動で閉じる秒数" VerticalAlignment="Center" />
            <TextBox x:Name="AutoCloseBox"
                     Grid.Column="1"
                     Width="70" HorizontalAlignment="Left"
                     Height="28" VerticalContentAlignment="Center"
                     TextAlignment="Center" />
            <TextBlock Grid.Column="1" Margin="80,0,0,0"
                       Text="秒 (0 = 自動で閉じない)"
                       VerticalAlignment="Center" FontSize="12" Foreground="#606060" />

            <TextBlock Grid.Row="1" Text="不透明度" VerticalAlignment="Center" />
            <Slider x:Name="OpacitySlider"
                    Grid.Row="1" Grid.Column="1"
                    Minimum="30" Maximum="100" Value="95"
                    TickFrequency="5" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    ValueChanged="OpacitySlider_ValueChanged" />
            <TextBlock x:Name="OpacityValueText"
                       Grid.Row="1" Grid.Column="2"
                       Text="95%" VerticalAlignment="Center" FontSize="12" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="保存" Width="84" Height="28" IsDefault="True" Click="Save_Click" />
            <Button Content="キャンセル" Width="84" Height="28" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

    </StackPanel>
</Window>
