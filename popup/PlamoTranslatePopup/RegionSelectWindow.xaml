<Window x:Class="PlamoTranslatePopup.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Cursor="Cross">

    <Canvas>
        <!-- 選択中の領域 -->
        <Border x:Name="SelectionRect"
                Visibility="Collapsed"
                BorderBrush="#FF3B82F6"
                BorderThickness="2"
                Background="#223B82F6" />

        <!-- サイズ表示 -->
        <Border x:Name="SizeLabel"
                Visibility="Collapsed"
                Background="#CC000000"
                CornerRadius="3"
                Padding="8,3"
                Canvas.ZIndex="10">
            <TextBlock x:Name="SizeText"
                       Foreground="White"
                       FontSize="12"
                       FontFamily="Consolas" />
        </Border>

        <!-- 先頭のヒント -->
        <Border Background="#CC000000"
                CornerRadius="4"
                Padding="12,6"
                Canvas.ZIndex="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0">
            <TextBlock Foreground="White"
                       FontSize="13">
                ドラッグで範囲を選択(Esc でキャンセル)
            </TextBlock>
        </Border>
    </Canvas>
</Window>
